---
// src/components/Nav.astro
interface Props {
  cityName?: string;
  citySlug?: string;
}
const { cityName, citySlug } = Astro.props;
---

<header class="fixed top-0 z-50 w-full bg-[#EDE6D9]/95 backdrop-blur-0 transition-all duration-300 border-b border-[#DED2BC]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav class="flex h-20 items-center justify-between">

      <!-- Logo Area -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 bg-[#2B1D16] rounded-lg flex items-center justify-center text-[#EDE6D9] transition-transform duration-300 group-hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        </div>
        <span class="font-serif font-bold text-xl text-[#2B1D16] tracking-tight group-hover:opacity-80 transition-opacity">
            Fördercheck
        </span>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-semibold text-[#6B5B4B]">
        <li>
          <a href="/" class="hover:text-brand-emerald transition-colors uppercase tracking-wider text-[11px] font-bold">Startseite</a>
        </li>
        <li>
          <a href="/ueber-uns/" class="hover:text-brand-emerald transition-colors uppercase tracking-wider text-[11px] font-bold">Über Uns</a>
        </li>
      </ul>

      <!-- CTA Buttons -->
      <div class="hidden md:flex items-center gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-transparent text-[#2B1D16] hover:text-brand-blue hover:border-brand-blue transition-all text-xs font-bold uppercase tracking-wider rounded-lg border border-[#DED2BC]">
            Anspruch prüfen
          </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-[#6B5B4B] hover:bg-[#E1D8C6] rounded-lg transition-colors"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
         <svg id="mobile-menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
         <svg id="mobile-menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

    </nav>

    <!-- Mobile Menu Panel -->
    <div id="mobile-menu" class="md:hidden hidden border-t border-[#DED2BC] py-4">
      <ul class="flex flex-col gap-1 text-sm font-bold text-[#2B1D16]">
        <li>
          <a href="/" class="block px-2 py-3 uppercase tracking-wider text-[11px] hover:text-brand-emerald transition-colors">Startseite</a>
        </li>
        <li>
          <a href="/ueber-uns/" class="block px-2 py-3 uppercase tracking-wider text-[11px] hover:text-brand-emerald transition-colors">Über Uns</a>
        </li>
        <li class="pt-2">
          <a href="/#calculator" class="block text-center px-5 py-3 bg-transparent text-[#2B1D16] hover:text-brand-blue hover:border-brand-blue transition-all text-xs font-bold uppercase tracking-wider rounded-lg border border-[#DED2BC]">
            Anspruch prüfen
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Menü öffnen' : 'Menü schließen');
  });

  // Close the mobile menu after navigating, so it doesn't stay open on
  // the next page (view transitions don't otherwise reset this state).
  document.addEventListener('astro:before-preparation', () => {
    menu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  });
</script>
