---
import LeadModal from './lead-modal.astro';
import AuthorityApp from './authority-app.jsx';
---

<section id="view-results" class="view-section max-w-4xl mx-auto hidden opacity-0 transition-opacity duration-500 pt-32 pb-24 px-6 relative z-20">

    <!-- Header -->
    <div class="mb-10 flex items-start justify-between gap-6">
        <div class="flex items-center gap-3">
            <button id="btn-back-home" class="md:hidden p-2.5 -ml-2 text-text-secondary hover:text-brand-navy transition-colors rounded-lg hover:bg-surface-muted">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <div>
                <h1 class="font-serif text-3xl md:text-4xl font-bold text-brand-navy tracking-tight" id="res-title-header">Ihre Auswertung</h1>
                <p class="text-text-secondary text-sm mt-1.5">Unverbindliche Ersteinschätzung, <span id="res-context-text">basierend auf Ihren Angaben</span>.</p>
            </div>
        </div>
        <div class="hidden md:flex gap-2 shrink-0">
            <button onclick="window.print()" class="p-3 border border-border-subtle rounded-lg text-text-secondary hover:text-brand-navy hover:border-brand-navy/30 transition-colors" title="Auswertung drucken" aria-label="Auswertung drucken">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            </button>
            <button onclick="location.reload()" class="flex items-center gap-2 px-4 py-3 border border-border-subtle rounded-lg text-text-secondary hover:text-brand-navy hover:border-brand-navy/30 transition-colors text-sm font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 12"/></svg>
                Neu berechnen
            </button>
        </div>
    </div>

    <!-- Offline Fallback Banner -->
    <div id="offline-fallback-banner" class="hidden mb-6 p-4 bg-[#FBF0DD] border border-[#E8C88A] rounded-lg flex items-center justify-between gap-4 text-left">
        <div class="flex items-start gap-3">
            <span class="text-brand-indigo mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </span>
            <div>
                <h4 class="text-sm font-bold text-brand-navy">Offline-Berechnung aktiv</h4>
                <p class="text-xs text-text-secondary mt-0.5">Das Live-Backend war nicht erreichbar. Die Ergebnisse wurden mit der lokalen Berechnung ermittelt.</p>
            </div>
        </div>
        <button onclick="location.reload()" class="shrink-0 px-4 py-2 bg-brand-navy text-white text-xs font-bold rounded-lg hover:bg-black/80 transition-colors">
            Erneut versuchen
        </button>
    </div>

    <!-- Sperrzeit Alert Banner -->
    <div id="sperrzeit-alert-banner" class="hidden mb-6 p-5 bg-[#F7E4DE] border-2 border-brand-blue/40 rounded-lg flex items-start gap-4 text-left">
        <div class="w-10 h-10 bg-brand-blue text-white rounded-lg flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div>
            <h4 class="text-base font-bold text-brand-navy" id="sperrzeit-alert-title">Achtung: Risiko für Sperrzeit / Kürzung</h4>
            <p class="text-sm text-text-secondary mt-1" id="sperrzeit-alert-text"></p>
        </div>
    </div>

    <!-- BAföG Priority Notice -->
    <div id="bafoeg-container" class="hidden mb-8 p-8 bg-surface-card border border-border-subtle rounded-card text-left">
        <div class="inline-flex items-center gap-2 bg-brand-indigo/10 text-brand-indigo px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-widest mb-4">
            Vorrangige Leistung
        </div>
        <h2 class="font-serif text-brand-navy font-bold text-2xl md:text-3xl mb-3 tracking-tight">BAföG-Prüfung geht vor</h2>
        <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-6 max-w-2xl">
            Auszubildende und Studierende haben in der Regel keinen Anspruch auf Bürgergeld oder reguläres Wohngeld, da BAföG oder BAB vorrangig beantragt werden müssen. In manchen Fällen (z. B. Ausschluss vom BAföG dem Grunde nach) kann dennoch ein Anspruch auf Wohngeld bestehen.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="window.openLeadModal('pdf-checklist')" class="inline-flex items-center justify-center gap-2 bg-brand-blue text-white font-bold px-6 py-3.5 rounded-btn hover:bg-brand-indigo transition-colors text-xs uppercase tracking-wider">
                Checkliste: BAföG &amp; Wohngeld
            </button>
            <a href="https://www.bafoeg-digital.de/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3.5 border border-border-subtle text-brand-navy text-xs font-bold uppercase tracking-wider rounded-btn hover:border-brand-blue hover:text-brand-blue transition-colors text-center">
                Direkt zu BAföG Digital ➔
            </a>
        </div>
    </div>

    <!-- Zero-Claim Reassurance -->
    <div id="dashboard-hero-zero" class="hidden mb-8 p-8 md:p-10 bg-surface-card border border-border-subtle rounded-card text-left">
        <div class="inline-flex items-center gap-2 bg-surface-muted text-text-secondary px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-widest mb-5">
            Prüfung empfohlen
        </div>
        <h2 class="font-serif text-brand-navy font-bold text-2xl md:text-3xl mb-4 tracking-tight">Kein direkter Anspruch ermittelt</h2>
        <p class="text-text-secondary text-base leading-relaxed mb-6 max-w-2xl">
            Unser Rechner hat auf Basis Ihrer Angaben keinen direkten Anspruch gefunden. <strong class="text-brand-navy">Fast jeder zweite behördliche Bescheid ist trotzdem fehlerhaft</strong> — viele Rechner erfassen Sondersituationen wie erhöhte Freibeträge, Mehrbedarfe oder chronische Erkrankungen nicht vollständig.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-7">
            <div class="flex gap-3 items-start p-4 bg-surface-base rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-emerald mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div>
                    <h5 class="text-xs font-bold text-brand-navy">Hohe Fehlerquote</h5>
                    <p class="text-xs text-text-secondary mt-0.5">Ämter rechnen Kaltmieten oder Freibeträge oft zu niedrig an.</p>
                </div>
            </div>
            <div class="flex gap-3 items-start p-4 bg-surface-base rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-emerald mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div>
                    <h5 class="text-xs font-bold text-brand-navy">Freibeträge &amp; Mehrbedarfe</h5>
                    <p class="text-xs text-text-secondary mt-0.5">Besondere Lebenssituationen erfasst der Rechner nicht vollständig.</p>
                </div>
            </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="#" onclick="window.openLeadModal('legal_help'); return false;" class="px-6 py-3.5 bg-brand-blue text-white text-xs font-bold uppercase tracking-wider rounded-btn hover:bg-brand-indigo transition-colors text-center">
                Bescheid kostenlos prüfen lassen
            </a>
            <a href="#" onclick="window.openLeadModal('pdf-checklist'); return false;" class="px-6 py-3.5 border border-border-subtle text-brand-navy text-xs font-bold uppercase tracking-wider rounded-btn hover:border-brand-blue hover:text-brand-blue transition-colors text-center">
                Checkliste für Einspruch laden
            </a>
        </div>
    </div>

    <!-- THE BESCHEID: total amount summary -->
    <div id="dashboard-hero-claim" class="hidden mb-10 p-8 md:p-10 bg-surface-card border-2 border-brand-blue/60 rounded-card text-left">
        <div class="inline-flex items-center gap-2 bg-brand-emerald/10 text-brand-emerald px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-widest mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald"></span>
            Berechnung abgeschlossen
        </div>
        <p class="text-text-secondary text-sm font-bold uppercase tracking-wide mb-1">Ihnen stehen insgesamt</p>
        <div class="flex items-baseline gap-2 mb-5">
            <span id="res-amount-hero" class="font-serif text-6xl md:text-7xl font-bold text-brand-blue tracking-tight">0€</span>
            <span class="text-text-secondary text-sm font-bold uppercase tracking-wide">/ Monat</span>
        </div>
        <p class="text-text-secondary text-sm leading-relaxed max-w-xl" id="res-summary-breakdown">
            <!-- Injected: "davon 737€ Wohngeld und 586€ Bürgergeld." -->
        </p>
    </div>

    <!-- YOUR BENEFITS — the core answer -->
    <div id="universal-benefits-section" class="hidden mb-12">
        <h2 class="font-serif text-brand-navy font-bold text-2xl md:text-3xl mb-2 tracking-tight">Diese Förderungen stehen Ihnen zu</h2>
        <p class="text-text-secondary text-sm mb-6 max-w-2xl">Für jede Leistung sehen Sie, warum sie Ihnen zusteht und wie Sie sie beantragen.</p>
        <div id="benefits-grouped-list" class="space-y-5">
            <!-- Injected dynamically by script -->
        </div>
    </div>

    <!-- Bescheid-Prüfung Banner -->
    <div id="bescheid-pruefung-banner" class="hidden mb-10 p-7 bg-surface-card border border-border-subtle rounded-card flex flex-col md:flex-row items-start md:items-center justify-between gap-5 text-left">
        <div class="flex items-start gap-4">
            <span class="text-brand-emerald bg-surface-base border border-border-subtle p-2.5 rounded-lg shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-4"/><path d="M9 15h6"/></svg>
            </span>
            <div>
                <h4 class="text-base font-bold text-brand-navy">Bescheid bereits erhalten? Jetzt kostenlos prüfen lassen.</h4>
                <p class="text-sm text-text-secondary mt-1 leading-relaxed max-w-lg">Fast jeder zweite behördliche Bescheid ist fehlerhaft. Unabhängige Fachanwälte prüfen Ihren aktuellen Bescheid kostenfrei auf Rechenfehler.</p>
            </div>
        </div>
        <a href="#" onclick="window.openLeadModal('legal_help'); return false;" class="shrink-0 w-full md:w-auto px-6 py-3.5 bg-brand-emerald hover:bg-[#3d4a38] text-white text-xs font-bold uppercase tracking-wider rounded-btn transition-colors text-center">
            Bescheid kostenlos prüfen
        </a>
    </div>

    <!-- Authority Finder & Application -->
    <div id="authority-finder-container" class="hidden mb-10">
        <h2 class="font-serif text-brand-navy font-bold text-2xl mb-2 tracking-tight">Wo reiche ich das genau ein?</h2>
        <p class="text-text-secondary text-sm mb-6 max-w-2xl">Geben Sie Ihre PLZ ein — wir zeigen Ihnen das zuständige Amt und bereiten den Antrag vor.</p>
        <AuthorityApp client:visible />
    </div>

    <!-- Not eligible: kept out of the way, not competing for attention -->
    <details id="benefits-none-section" class="hidden mb-10 group">
        <summary class="cursor-pointer text-sm font-bold text-text-secondary hover:text-brand-navy transition-colors list-none flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <span id="benefits-none-toggle-label">Weitere geprüfte Leistungen ohne Anspruch anzeigen</span>
        </summary>
        <ul id="benefits-none-list" class="mt-4 space-y-2 pl-6 border-l border-border-subtle">
            <!-- Injected dynamically by script -->
        </ul>
    </details>

    <!-- Savings Opportunities -->
    <div id="opportunities-section" class="hidden mb-10">
        <h3 class="font-serif text-brand-navy font-bold text-xl mb-5 tracking-tight">Weitere Spar-Potenziale</h3>
        <div id="opportunities-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Injected dynamically by script -->
        </div>
    </div>

    <!-- Modals -->
    <LeadModal />
</section>

<script>
    console.log("ResultsSection: Script initializing...");

    // Plain-language "where & how to apply" per benefit id — surfaced explicitly
    // on every card because that was the #1 clarity complaint about this page:
    // amounts were shown but not where/how to actually get the money.
    const WHERE_TEXT = {
        wohngeld: "Bei der Wohngeldbehörde Ihrer Stadt oder Gemeinde",
        lastenzuschuss: "Bei der Wohngeldbehörde Ihrer Stadt oder Gemeinde",
        buergergeld: "Bei Ihrem örtlichen Jobcenter",
        grundsicherung_alter: "Beim Sozialamt Ihrer Stadt oder Gemeinde",
        erstausstattung: "Beim zuständigen Jobcenter oder Sozialamt",
        kindergeld: "Bei der Familienkasse der Agentur für Arbeit",
        kinderzuschlag: "Bei der Familienkasse der Agentur für Arbeit",
        elterngeld: "Bei der Elterngeldstelle Ihres Bundeslandes",
        gez_exempt: "Online beim Beitragsservice von ARD, ZDF und Deutschlandradio",
        bafoeg: "Beim BAföG-Amt bzw. Studierendenwerk",
        bab: "Bei der Agentur für Arbeit",
        telekom_social: "Direkt bei der Telekom",
        unterhaltsvorschuss: "Beim Jugendamt Ihrer Stadt oder Gemeinde",
        but: "Beim Jobcenter oder Sozialamt (Bildungspaket)",
        bildungsgutschein: "Bei der Agentur für Arbeit",
        hinterbliebenenrente: "Bei der Deutschen Rentenversicherung",
        kita_exempt: "Beim Jugendamt bzw. Ihrer Kita-Trägerschaft",
        kurzarbeitergeld: "Über Ihren Arbeitgeber bei der Agentur für Arbeit",
        bay_familiengeld: "Beim Zentrum Bayern Familie und Soziales (ZBFS)",
        krippengeld: "Beim ZBFS bzw. der zuständigen Landesbehörde",
        eingliederungszuschuss: "Bei der Agentur für Arbeit (Arbeitgeber-Antrag)",
        schwerbehinderung: "Beim Versorgungsamt"
    };

    // Same call-to-action target/label per id as before, just returned as data
    // instead of raw HTML so we can render it consistently inside the new card
    // layout and pair it with the matching "where" text above.
    function getCta(benefit) {
        const primaryBtn = "inline-flex items-center justify-center gap-1.5 px-5 py-3 rounded-btn bg-brand-blue text-white text-xs font-bold uppercase tracking-wider hover:bg-brand-indigo transition-colors";
        const ghostBtn = "inline-flex items-center justify-center gap-1.5 px-5 py-3 rounded-btn border border-border-subtle text-brand-navy text-xs font-bold uppercase tracking-wider hover:border-brand-blue hover:text-brand-blue transition-colors";

        switch (benefit.id) {
            case 'wohngeld':
                return { html: `<a href="/pdf-paket/?type=Wohngeld" class="${primaryBtn}">Antrag jetzt ausfüllen ➔</a>` };
            case 'lastenzuschuss':
                return { html: `<a href="/pdf-paket/?type=Lastenzuschuss" class="${primaryBtn}">Antrag jetzt ausfüllen ➔</a>` };
            case 'buergergeld':
                return { html: `<a href="/pdf-paket/?type=Bürgergeld" class="${primaryBtn}">Antrag jetzt ausfüllen ➔</a>` };
            case 'grundsicherung_alter':
                return { html: `<a href="/pdf-paket/?type=Grundsicherung" class="${primaryBtn}">Antrag jetzt ausfüllen ➔</a>` };
            case 'erstausstattung':
                return { html: `<a href="/pdf-paket/?type=Erstausstattung" class="${primaryBtn}">Antrag jetzt ausfüllen ➔</a>` };
            case 'kindergeld':
                return { html: `<a href="https://www.arbeitsagentur.de/familie-und-kinder/kindergeld-beantragen" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Direkt beantragen ➔</a>` };
            case 'kinderzuschlag':
                return { html: `<a href="#" onclick="window.openLeadModal('kiz'); return false;" class="${ghostBtn}">Kostenlose Prüfung anfordern ➔</a>` };
            case 'elterngeld':
                return { html: `<a href="#" onclick="window.openLeadModal('elterngeld'); return false;" class="${ghostBtn}">Elterngeld-Hilfe starten ➔</a>` };
            case 'gez_exempt':
                return { html: `<a href="https://www.rundfunkbeitrag.de/buergerinnen_und_buerger/formulare/befreiung_oder_ermaessigung/index_ger.html" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Befreiung online beantragen ➔</a>` };
            case 'bafoeg':
                return { html: `<a href="https://www.bafoeg-digital.de/" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">BAföG Digital starten ➔</a>` };
            case 'bab':
                return { html: `<a href="https://www.arbeitsagentur.de/bildung/ausbildung/berufsausbildungsbeihilfe-beantragen" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">BAB beantragen ➔</a>` };
            case 'telekom_social':
                return { html: `<a href="https://www.telekom.de/hilfe/vertrag-meine-daten/meine-daten/sozialtarif" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Telekom Sozialtarif ➔</a>` };
            case 'unterhaltsvorschuss':
                return { html: `<a href="https://www.bmfsfj.de/bmfsfj/themen/familie/familienleistungen/unterhaltsvorschuss/unterhaltsvorschuss-73558" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Mehr erfahren ➔</a>` };
            case 'but':
                return { html: `<a href="/bildung-und-teilhabe/" class="${ghostBtn}">Details zu Bildung &amp; Teilhabe ➔</a>` };
            case 'bildungsgutschein':
                return { html: `<a href="https://www.arbeitsagentur.de/karriere-und-weiterbildung/foerderung-weiterbildung/bildungsgutschein" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Infos zum Bildungsgutschein ➔</a>` };
            case 'hinterbliebenenrente':
                return { html: `<a href="https://www.deutsche-rentenversicherung.de/DRV/DE/Rente/Hinterbliebenenrente/hinterbliebenenrente_node.html" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Hinterbliebenenrente beantragen ➔</a>` };
            case 'kita_exempt':
                return { html: `<a href="https://www.arbeitsagentur.de/familie-und-kinder/kinderzuschlag-verstehen/kita-gebuehren-sparen" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Infos zur Gebührenbefreiung ➔</a>` };
            case 'kurzarbeitergeld':
                return { html: `<a href="https://www.arbeitsagentur.de/unternehmen/finanziell/kurzarbeitergeld-uebersicht" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Kurzarbeitergeld-Info ➔</a>` };
            case 'bay_familiengeld':
                return { html: `<a href="https://www.zbfs.bayern.de/familie/familiengeld/index.php" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">ZBFS Familiengeld Portal ➔</a>` };
            case 'krippengeld':
                if (benefit.type && benefit.type.includes('Hessen')) {
                    return { html: `<a href="https://soziales.hessen.de/familie/kinderbetreuung" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Kita-Gebühren Hessen ➔</a>` };
                }
                return { html: `<a href="https://www.zbfs.bayern.de/familie/krippengeld/index.php" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">ZBFS Krippengeld Portal ➔</a>` };
            case 'eingliederungszuschuss':
                return { html: `<a href="https://www.arbeitsagentur.de/unternehmen/finanziell/eingliederungszuschuss" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Infos für Arbeitgeber ➔</a>` };
            case 'schwerbehinderung':
                return { html: `<a href="https://www.einfach-teilhaben.de/DE/AS/Schwerbehindertenausweis/schwerbehindertenausweis_node.html" target="_blank" rel="noopener noreferrer" class="${ghostBtn}">Ausweis-Infos ➔</a>` };
            default:
                if (benefit.category === 'Pflege') {
                    return { html: `<a href="#" onclick="window.openLeadModal('pflege'); return false;" class="${ghostBtn}">Hilfe beim Kassenantrag ➔</a>` };
                }
                return { html: `<a href="#" onclick="window.openLeadModal('pdf-checklist'); return false;" class="${ghostBtn}">Checkliste anfordern ➔</a>` };
        }
    }

    // 1. DEFINE SHOWVIEW GLOBALLY FIRST (Critical for Navigation)
    window.showView = (viewId) => {
        console.log("showView called for:", viewId);

        const homeView = document.getElementById('view-home');
        const resultsView = document.getElementById('view-results');

        if (viewId === 'results') {
            if (homeView) homeView.style.display = 'none'; // HARD HIDE
            if (resultsView) {
                resultsView.classList.remove('hidden');
                resultsView.style.display = 'block';
                resultsView.style.opacity = '1'; // Ensure visible

                // Scroll to top
                window.scrollTo(0, 0);
            }
        } else if (viewId === 'home') {
            if (resultsView) resultsView.style.display = 'none';
            if (homeView) {
                homeView.style.display = 'block';
                window.scrollTo(0, 0);
            }
        }
    };

    document.getElementById('btn-back-home')?.addEventListener('click', () => {
        window.showView('home');
    });

    // 2. MAIN EVENT LISTENER
    window.addEventListener('benefit-calculation-completed', async (event) => {
        console.log("ResultsSection: Event Received", event.detail);

        // Save for React components (AuthorityApp)
        window.lastCalculationResult = event.detail;

        const { detail: result } = event;
        const { input, type, results } = result;

        // Offline Fallback Banner handling
        const offlineBanner = document.getElementById('offline-fallback-banner');
        if (offlineBanner) {
            if (result.isOfflineResult) {
                offlineBanner.classList.remove('hidden');
            } else {
                offlineBanner.classList.add('hidden');
            }
        }

        // Sperrzeit Alert Banner handling
        const alertRes = (results || []).find(r => r.id === "sperrzeit_alert");
        const alertBanner = document.getElementById('sperrzeit-alert-banner');
        if (alertBanner) {
            if (alertRes) {
                const alertTitleEl = document.getElementById('sperrzeit-alert-title');
                const alertTextEl = document.getElementById('sperrzeit-alert-text');
                if (alertTitleEl) alertTitleEl.textContent = alertRes.title || "Achtung: Sperrzeit-Risiko erkannt";
                if (alertTextEl) alertTextEl.textContent = alertRes.description || "";
                alertBanner.classList.remove('hidden');
            } else {
                alertBanner.classList.add('hidden');
            }
        }

        // Dynamic Opportunities Grid handling
        const opportunitiesSection = document.getElementById('opportunities-section');
        const opportunitiesGrid = document.getElementById('opportunities-grid');
        const opps = result.opportunities || [];

        if (opportunitiesSection && opportunitiesGrid) {
            if (opps.length > 0) {
                opportunitiesSection.classList.remove('hidden');
                opportunitiesGrid.innerHTML = opps.map(opp => {
                    return `
                        <div class="bg-surface-card border border-border-subtle p-5 rounded-card flex flex-col justify-between text-left">
                            <div>
                                <h4 class="text-sm font-bold text-brand-navy mb-1.5">${opp.title}</h4>
                                <p class="text-xs text-text-secondary leading-relaxed">${opp.text}</p>
                            </div>
                            <a href="${opp.link}" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center justify-center px-4 py-2.5 border border-border-subtle text-brand-navy text-xs font-bold rounded-btn hover:border-brand-blue hover:text-brand-blue transition-colors">
                                ${opp.action || 'Jetzt prüfen'}
                            </a>
                        </div>
                    `;
                }).join('');
            } else {
                opportunitiesSection.classList.add('hidden');
                opportunitiesGrid.innerHTML = '';
            }
        }

        const probableBenefits = (results || []).filter(r => r.eligible === 'probable');
        const probableWithAmount = probableBenefits.filter(r => (r.amount || 0) > 0);
        const totalAmount = probableWithAmount.reduce((sum, r) => sum + (r.amount || 0), 0);

        // Render the entitlement list — probable + possible get full cards
        // answering "what / why / where & how / apply now"; "none" collapses
        // into a quiet disclosure so it never competes with real entitlements.
        const universalSection = document.getElementById('universal-benefits-section');
        const groupedListEl = document.getElementById('benefits-grouped-list');
        const noneSection = document.getElementById('benefits-none-section');
        const noneListEl = document.getElementById('benefits-none-list');
        const noneToggleLabel = document.getElementById('benefits-none-toggle-label');

        const relevantBenefits = (results || []).filter(r => r.id !== 'sperrzeit_alert' && (r.eligible === 'probable' || r.eligible === 'possible'));
        const noneBenefits = (results || []).filter(r => r.id !== 'sperrzeit_alert' && r.eligible === 'none');

        if (universalSection && groupedListEl && relevantBenefits.length > 0) {
            universalSection.classList.remove('hidden');

            const sorted = [...relevantBenefits].sort((a, b) => {
                if (a.eligible !== b.eligible) return a.eligible === 'probable' ? -1 : 1;
                return (b.amount || 0) - (a.amount || 0);
            });

            groupedListEl.innerHTML = sorted.map(benefit => {
                const isProbable = benefit.eligible === 'probable';
                const statusBadge = isProbable
                    ? `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-blue/10 text-brand-blue text-[10px] font-bold uppercase tracking-widest shrink-0">Steht Ihnen zu</span>`
                    : `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-muted text-text-secondary text-[10px] font-bold uppercase tracking-widest shrink-0">Prüfung lohnt sich</span>`;

                const amountText = benefit.amount > 0
                    ? `${Math.round(benefit.amount).toLocaleString('de-DE')} € / Monat`
                    : (benefit.id === 'kinderzuschlag' ? 'bis zu 297 € / Kind' : (benefit.id === 'but' ? '195 € / Schuljahr' : null));

                const where = WHERE_TEXT[benefit.id] || "Wir zeigen Ihnen die passende Stelle im nächsten Schritt";
                const cta = getCta(benefit);

                return `
                    <article class="bg-surface-card border ${isProbable ? 'border-brand-blue/30' : 'border-border-subtle'} rounded-card p-6 md:p-7 text-left">
                        <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                            <h3 class="font-sans font-bold text-brand-navy text-xl">${benefit.name}</h3>
                            <div class="flex items-center gap-2 shrink-0">
                                ${statusBadge}
                                ${amountText ? `<span class="font-serif font-bold text-brand-blue text-lg whitespace-nowrap">${amountText}</span>` : ''}
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-widest text-text-tertiary mb-1.5">Warum steht Ihnen das zu?</p>
                                <p class="text-sm text-text-secondary leading-relaxed">${benefit.reasoning || ''}</p>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-widest text-text-tertiary mb-1.5">Wo &amp; wie beantragen?</p>
                                <p class="text-sm text-text-secondary leading-relaxed">${where}</p>
                            </div>
                        </div>

                        <div>${cta.html}</div>
                    </article>
                `;
            }).join('');
        } else if (universalSection) {
            universalSection.classList.add('hidden');
        }

        if (noneSection && noneListEl) {
            if (noneBenefits.length > 0) {
                noneSection.classList.remove('hidden');
                if (noneToggleLabel) noneToggleLabel.textContent = `${noneBenefits.length} weitere geprüfte ${noneBenefits.length === 1 ? 'Leistung' : 'Leistungen'} ohne Anspruch anzeigen`;
                noneListEl.innerHTML = noneBenefits.map(b => `
                    <li class="text-sm text-text-secondary">
                        <span class="font-bold text-brand-navy">${b.name}:</span> ${b.reasoning || 'Kein Anspruch auf Basis Ihrer Angaben.'}
                    </li>
                `).join('');
            } else {
                noneSection.classList.add('hidden');
                noneListEl.innerHTML = '';
            }
        }

        // Switch View Immediately
        window.showView('results');

        // Hero / section toggles
        const amountEl = document.getElementById('res-amount-hero');
        const titleHeader = document.getElementById('res-title-header');
        const contextText = document.getElementById('res-context-text');
        const summaryBreakdown = document.getElementById('res-summary-breakdown');

        const heroClaimEl = document.getElementById('dashboard-hero-claim');
        const heroZeroEl = document.getElementById('dashboard-hero-zero');
        const bescheidBanner = document.getElementById('bescheid-pruefung-banner');
        const authorityFinder = document.getElementById('authority-finder-container');
        const bafoegContainer = document.getElementById('bafoeg-container');

        const isBafoeg = (type === 'BAföG-Prüfung');

        if (isBafoeg) {
            heroClaimEl?.classList.add('hidden');
            heroZeroEl?.classList.add('hidden');
            bafoegContainer?.classList.remove('hidden');
            bescheidBanner?.classList.add('hidden');
            authorityFinder?.classList.add('hidden');
        } else if (totalAmount === 0) {
            heroClaimEl?.classList.add('hidden');
            heroZeroEl?.classList.remove('hidden');
            bafoegContainer?.classList.add('hidden');
            bescheidBanner?.classList.add('hidden');
            authorityFinder?.classList.add('hidden');
        } else {
            heroClaimEl?.classList.remove('hidden');
            heroZeroEl?.classList.add('hidden');
            bafoegContainer?.classList.add('hidden');
            bescheidBanner?.classList.remove('hidden');
            authorityFinder?.classList.remove('hidden');
        }

        if (!isBafoeg && totalAmount > 0) {
            // Animate the headline number (one authored moment, not decorative).
            if (amountEl) {
                const start = 0;
                const end = Math.round(totalAmount);
                const duration = 800;
                const startTime = performance.now();

                const animate = (currentTime) => {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const ease = 1 - Math.pow(1 - progress, 4);
                    const currentVal = Math.floor(start + (end - start) * ease);
                    amountEl.textContent = `${currentVal.toLocaleString('de-DE')}€`;

                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    } else {
                        amountEl.textContent = `${end.toLocaleString('de-DE')}€`;
                    }
                };
                requestAnimationFrame(animate);
            }

            if (summaryBreakdown) {
                const sortedProbable = [...probableWithAmount].sort((a, b) => (b.amount || 0) - (a.amount || 0));
                if (sortedProbable.length > 1) {
                    const parts = sortedProbable.map(b => `${Math.round(b.amount).toLocaleString('de-DE')} € ${b.name}`);
                    const last = parts.pop();
                    summaryBreakdown.textContent = `Zusammengesetzt aus ${parts.join(', ')} und ${last}.`;
                } else if (sortedProbable.length === 1) {
                    summaryBreakdown.textContent = `Das ist Ihr Anspruch auf ${sortedProbable[0].name}.`;
                } else {
                    summaryBreakdown.textContent = '';
                }
            }
        }

        // Header title & context text
        const cityName = (typeof input.city === 'object' && input.city !== null) ? input.city.stadt : input.city;

        if (titleHeader) {
            titleHeader.textContent = cityName
                ? `Ihre Auswertung für ${cityName}`
                : `Ihre Auswertung`;
        }

        if (contextText) {
            contextText.textContent = cityName ? `basierend auf Ihren Angaben für ${cityName}` : `basierend auf Ihren Angaben`;
        }

        // Confetti (Immediate Reward)
        if (window.confetti && !isBafoeg && totalAmount > 0) {
            window.confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#9C4A32', '#4B5A45', '#7F4F1A']
            });
        }
    });
</script>
