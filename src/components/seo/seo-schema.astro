---
// src/components/seo/SchemaOrg.astro

interface Props {
  type: 'Organization' | 'Website' | 'Article' | 'SoftwareApplication' | 'GovernmentService' | 'FAQPage';
  data?: any;
}

const { type, data } = Astro.props;

// Hardcoded to match astro.config.mjs's `site` value exactly — Astro.site/
// Astro.url.origin proved unreliable here and were emitting the non-www apex
// domain in JSON-LD @id/url values while every canonical tag correctly used
// www (SEO audit, schema.md #3). This is the single source of truth.
const siteUrl = 'https://www.sozialer-navigator.de';

// 1. Organization (Global Base)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Fördercheck",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`, // Placeholder, ensure this exists or use a valid path
  "description": "Ihr unabhängiger Ratgeber für Sozialleistungen, Wohngeld und Bürgergeld in Deutschland.",
  "sameAs": [
    // Add social profiles here if available
  ]
};

// 2. WebSite (Global Base)
// No SearchAction: there is no working /suche results page on this site, and
// shipping a SearchAction pointing at a dead end is worse than omitting it
// (SEO audit, schema.md #2). Add it back only once a real search page exists.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Fördercheck",
  "url": siteUrl
};

let schema = null;

if (type === 'Organization') {
  schema = organizationSchema;
} else if (type === 'Website') {
    schema = websiteSchema;
} else if (type === 'SoftwareApplication') {
  // For the Calculator. Uses WebApplication (more precise than the generic
  // SoftwareApplication for a browser-based, install-free tool) and references
  // the Organization by @id instead of embedding a duplicate inline copy
  // (SEO audit, schema.md #4/#5). Defaults describe the actual universal
  // benefit checker, not a narrower legacy "Wohngeldrechner" product.
  schema = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": data?.name || "Amtly Universal-Förderscheck",
    "url": siteUrl,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "provider": { "@id": `${siteUrl}/#organization` },
    "description": data?.description || "Kostenloser Universal-Förderscheck: Prüfen Sie in 2 Minuten anonym Ihren Anspruch auf Wohngeld, Bürgergeld, Kinderzuschlag und weitere staatliche Zuschüsse.",
    "featureList": data?.featureList || "Anspruchsberechnung für Wohngeld, Bürgergeld und Kinderzuschlag, Mietstufen-Check, Einkommensprüfung, automatisch befülltes Antrags-PDF"
  };
} else if (type === 'Article' || type === 'TechnicalArticle') {
  // For Info Pages
  schema = {
    "@context": "https://schema.org",
    "@type": "TechnicalArticle", // Using TechnicalArticle for "authoritative" feel on complex topics
    "headline": data?.title,
    "description": data?.description,
    "image": data?.image || `${siteUrl}/og-image.jpg`,
    "author": {
      "@type": "Organization",
      "name": "Fördercheck Redaktion"
    },
    "publisher": organizationSchema,
    "datePublished": data?.datePublished || new Date().toISOString().split('T')[0],
    "dateModified": data?.dateModified || new Date().toISOString().split('T')[0],
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": data?.url
    }
  };
} else if (type === 'GovernmentService') {
  // For City Pages
  schema = {
    "@context": "https://schema.org",
    "@type": "GovernmentService",
    "name": `Wohngeldstelle ${data?.city}`,
    "serviceType": "Wohngeld",
    "provider": {
        "@type": "GovernmentOrganization",
        "name": data?.authorityName || "Wohngeldbehörde",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": data?.address || "",
            "addressLocality": data?.city,
            "postalCode": data?.zip || "",
            "addressCountry": "DE"
        }
    },
    "areaServed": {
        "@type": "City",
        "name": data?.city
    },
    "url": data?.url
  };
} else if (type === 'FAQPage') {
    // For FAQ Sections
    schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": data?.items?.map(item => ({
            "@type": "Question",
            "name": item.q,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.a
            }
        }))
    };
} else if (type === 'BreadcrumbList') {
    // For Breadcrumbs
    schema = {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": data?.items?.map((item, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": item.name,
            "item": item.url ? (item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`) : undefined
        }))
    };
}

---
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
