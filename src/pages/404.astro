---
import Layout from '../layouts/layout.astro';
import { Button } from '../components/ui/button';
---

<Layout title="404 - Seite nicht gefunden | Fördercheck">
  <div class="min-h-[80vh] flex flex-col items-center justify-center text-center px-6 relative overflow-hidden bg-surface-base">
    <h1 class="text-[12rem] font-serif font-bold text-[#2B1D16]/5 select-none absolute z-0 leading-none tracking-tighter">404</h1>

    <div class="relative z-10 bg-surface-card border border-border-subtle p-10 md:p-12 rounded-card max-w-lg w-full shadow-[0_20px_48px_-16px_rgba(43,29,22,0.18)]">
      <div class="w-16 h-16 bg-surface-base border border-border-subtle text-brand-blue rounded-lg flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8"/><circle cx="10" cy="10" r="7"/><path d="M7 10h6"/></svg>
      </div>
      <h2 class="font-serif text-3xl font-bold text-brand-navy mb-4 tracking-tight">Upps! Sackgasse.</h2>
      <p class="text-lg text-text-secondary mb-10 leading-relaxed">
        Diese Seite existiert nicht (mehr). Aber wir lassen dich nicht im Regen stehen.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="w-full sm:w-auto">
          <Button className="w-full h-14 bg-brand-blue hover:bg-brand-indigo text-white rounded-btn font-bold text-base">
            Zur Startseite
          </Button>
        </a>
        <a href="/#calculator" class="w-full sm:w-auto">
          <Button variant="outline" className="w-full h-14 border border-border-subtle text-brand-navy hover:border-brand-blue hover:text-brand-blue rounded-btn font-bold text-base bg-transparent">
            Zum Rechner
          </Button>
        </a>
      </div>
    </div>
  </div>
</Layout>
