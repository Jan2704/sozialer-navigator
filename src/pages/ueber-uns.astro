---
// src/pages/ueber-uns.astro - Fördercheck 2026
import Layout from '../layouts/layout.astro';
import SchemaOrg from '../components/seo/seo-schema.astro';
import '../styles/global.css';

const title = "Unsere Mission & Vision | Fördercheck";
const description = "Wir demokratisieren den Zugang zu sozialen Rechten durch Technologie. Erfahren Sie mehr über unsere Vision bei Fördercheck.";
---

<Layout title={title} description={description} activePage="ueber-uns">
    <fragment slot="head">
        <SchemaOrg
            type="BreadcrumbList"
            data={{
                items: [
                    { name: "Startseite", url: "/" },
                    { name: "Über uns", url: "/ueber-uns" }
                ]
            }}
        />

    </fragment>

    <main class="min-h-screen bg-surface-base pt-0 pb-32">

        <!-- HERO SECTION -->
        <section class="pt-40 pb-24 px-6 bg-surface-base border-b border-border-subtle">
             <div class="max-w-4xl mx-auto text-left">
                 <p class="text-text-secondary text-sm font-bold uppercase tracking-widest mb-5">Wer wir sind</p>
                 <h1 class="font-serif font-bold text-brand-navy mb-8 leading-[1.15] tracking-tight text-4xl md:text-5xl lg:text-[3.4rem]">
                    Demokratischer Zugang <span class="text-brand-blue">zu deinem Recht.</span>
                 </h1>
                 <p class="text-xl text-text-secondary max-w-2xl leading-relaxed">
                    Fördercheck schließt die Lücke zwischen komplexer Bürokratie und deinen echten gesetzlichen Ansprüchen. Unabhängig, präzise und zu 100 % digital.
                 </p>
             </div>
        </section>

        <!-- MISSION & VISION -->
        <section class="py-24 px-6 bg-surface-muted border-b border-border-subtle">
            <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-8 items-stretch">

                <!-- Card 1: MISSION -->
                <div class="bg-surface-card border border-border-subtle rounded-card p-10 md:p-12 flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 bg-surface-base border border-border-subtle rounded-lg flex items-center justify-center text-brand-blue mb-8">
                            <i data-lucide="target" class="w-6 h-6"></i>
                        </div>

                        <h2 class="font-serif text-3xl font-bold text-brand-navy mb-6">Unsere Mission</h2>

                        <p class="text-text-secondary leading-relaxed text-base">
                            Staatliche Hilfe ist ein Recht, kein Almosen. Jedes Jahr bleiben jedoch Milliarden Euro an Zuschüssen ungenutzt, weil Anträge zu kompliziert sind oder Rechte schlicht unbekannt bleiben.
                        </p>
                        <p class="text-text-secondary leading-relaxed text-base mt-4">
                            <strong class="text-brand-navy">Wir ändern das.</strong> Unsere Mission ist es, den Zugang zu Ihren sozialen Ansprüchen radikal zu vereinfachen. Wir übersetzen Amtsdeutsch in einfache Fragen und befüllen offizielle Formulare vollautomatisch – damit Sie ohne Hürden bekommen, was Ihnen gesetzlich zusteht.
                        </p>
                    </div>

                    <div class="mt-8 pt-6 border-t border-border-subtle">
                        <span class="text-xs font-bold uppercase tracking-widest text-brand-indigo">Unkompliziert · Anonym · Schnell</span>
                    </div>
                </div>

                <!-- Card 2: VISION -->
                <div class="bg-brand-navy border border-brand-navy rounded-card p-10 md:p-12 flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-white mb-8">
                            <i data-lucide="compass" class="w-6 h-6"></i>
                        </div>

                        <h2 class="font-serif text-3xl font-bold text-white mb-6">Unsere Vision</h2>

                        <p class="text-[#C9BBA8] leading-relaxed text-base">
                            Wir glauben an eine barrierefreie, unbürokratische Gesellschaft, in der jeder Mensch seine berechtigten Ansprüche mit wenigen Klicks und ohne juristische Barrieren geltend machen kann.
                        </p>
                        <p class="text-[#C9BBA8] leading-relaxed text-base mt-4">
                            Fördercheck soll die führende, unabhängige Infrastruktur für soziale Gerechtigkeit im digitalen Zeitalter werden. Durch die Verbindung von smarter Berechnung und Zero-Knowledge-Sicherheit schaffen wir das vertrauenswürdigste Portal für Ihre staatlichen Fördermittel.
                        </p>
                    </div>

                    <div class="mt-8 pt-6 border-t border-white/10">
                        <span class="text-xs font-bold uppercase tracking-widest text-[#C9BBA8]">Barrierefrei · Transparent · Unabhängig</span>
                    </div>
                </div>

            </div>
        </section>

        <!-- PRINCIPLES GRID -->
        <section class="bg-surface-base py-24 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-20 max-w-2xl mx-auto">
                     <h2 class="font-serif text-4xl font-bold text-brand-navy mb-4">Nach welchen Werten wir arbeiten.</h2>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Value 1 -->
                    <div class="bg-surface-card p-8 rounded-card border border-border-subtle text-left">
                        <div class="w-12 h-12 bg-surface-base rounded-lg flex items-center justify-center text-brand-blue mb-6 border border-border-subtle">
                            <i data-lucide="shield-check" class="w-5 h-5"></i>
                        </div>
                        <h3 class="font-sans text-xl font-bold text-brand-navy mb-3">Absolute Unabhängigkeit</h3>
                        <p class="text-text-secondary leading-relaxed text-sm">
                            Wir sind keine staatliche Behörde, sondern ein unabhängiger Technologieträger. Wir stehen zu 100 % auf Ihrer Seite und helfen Ihnen, Ihre Rechte unvoreingenommen und beweissicher geltend zu machen.
                        </p>
                    </div>

                    <!-- Value 2 -->
                    <div class="bg-surface-card p-8 rounded-card border border-border-subtle text-left">
                        <div class="w-12 h-12 bg-surface-base rounded-lg flex items-center justify-center text-brand-blue mb-6 border border-border-subtle">
                             <i data-lucide="lock" class="w-5 h-5"></i>
                        </div>
                        <h3 class="font-sans text-xl font-bold text-brand-navy mb-3">Zero-Knowledge Privatsphäre</h3>
                        <p class="text-text-secondary leading-relaxed text-sm">
                            Ihre Daten gehören ausschließlich Ihnen. Der PDF-Ausfüll-Assistent arbeitet komplett lokal im Browser Ihres Geräts. Sensible Daten wie Name, Anschrift oder IBAN werden niemals an unsere Server übertragen.
                        </p>
                    </div>

                    <!-- Value 3 -->
                    <div class="bg-surface-card p-8 rounded-card border border-border-subtle text-left">
                         <div class="w-12 h-12 bg-surface-base rounded-lg flex items-center justify-center text-brand-blue mb-6 border border-border-subtle">
                             <i data-lucide="calendar" class="w-5 h-5"></i>
                        </div>
                        <h3 class="font-sans text-xl font-bold text-brand-navy mb-3">Aktuellste Gesetzgebung 2026</h3>
                        <p class="text-text-secondary leading-relaxed text-sm">
                            Das Sozialrecht ändert sich ständig. Unser smarter Berechnungs-Algorithmus wird fortlaufend gewartet und auf Basis der neuesten bundes- und landesrechtlichen Regelsätze sowie Mietstufen aktualisiert.
                        </p>
                    </div>

                    <!-- Value 4 -->
                    <div class="bg-surface-card p-8 rounded-card border border-border-subtle text-left">
                        <div class="w-12 h-12 bg-surface-base rounded-lg flex items-center justify-center text-brand-blue mb-6 border border-border-subtle">
                            <i data-lucide="badge-percent" class="w-5 h-5"></i>
                        </div>
                        <h3 class="font-sans text-xl font-bold text-brand-navy mb-3">100% Kostenloser Check</h3>
                        <p class="text-text-secondary leading-relaxed text-sm">
                            Der Zugang zu Information darf kein Privileg sein. Daher bleibt der komplette Universal-Fördercheck sowie das lokale Ausfüllen der PDFs für jeden Nutzer stets kostenfrei und ohne Anmeldung nutzbar.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA / DISCLAIMER -->
        <section class="max-w-4xl mx-auto px-6 mt-16 text-left">
             <div class="bg-brand-navy text-white p-8 md:p-10 rounded-card">
                 <div class="flex items-start gap-5">
                     <div class="shrink-0 text-[#C98A2E]">
                         <i data-lucide="info" class="w-6 h-6"></i>
                     </div>
                     <div>
                        <h3 class="text-sm font-bold uppercase tracking-widest mb-2 text-[#C9BBA8]">Rechtlicher Hinweis</h3>
                        <p class="text-[#C9BBA8] leading-relaxed text-sm">
                            Fördercheck ist ein privatwirtschaftlicher, unabhängiger Dienstleister und keine Behörde der Stadtverwaltung oder des Bundes. Wir bieten eine automatisierte Orientierungshilfe an. Unsere Berechnungen dienen der Information und stellen keine formelle Rechtsberatung dar.
                        </p>
                     </div>
                 </div>
             </div>
        </section>

    </main>

    <script is:inline defer src="/scripts/lucide.min.js"></script>
    <script is:inline>
        if (window.lucide) window.lucide.createIcons();
        document.addEventListener('astro:page-load', () => {
            if (window.lucide) window.lucide.createIcons();
        });
    </script>

</Layout>
