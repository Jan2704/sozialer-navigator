---
export const prerender = false;

import Layout from '../../layouts/layout.astro';
import { createClient } from '@supabase/supabase-js';

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;
const SERVICE_KEY = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;
const SITE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const isProd = process.env.VERCEL_ENV === 'production';

let isAuthenticated = false;
let leads = [];
let error = ADMIN_PASSWORD ? "" : "ADMIN_PASSWORD fehlt in .env — Login ist deaktiviert.";

// 1. Cookie Auth Check
const cookieAuth = Astro.cookies.get("admin_auth");
if (ADMIN_PASSWORD && cookieAuth && cookieAuth.value === ADMIN_PASSWORD) {
    isAuthenticated = true;
}

// 2. Login (only if not already authenticated via cookie)
if (!isAuthenticated && ADMIN_PASSWORD && Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const password = formData.get("password");
    if (password === ADMIN_PASSWORD) {
        isAuthenticated = true;
        Astro.cookies.set("admin_auth", ADMIN_PASSWORD, {
            path: '/admin',
            maxAge: 60 * 60 * 24, // 1 day
            httpOnly: true,
            sameSite: 'strict',
            secure: isProd,
        });
    } else {
        error = "Falsches Passwort";
    }
}

// 3. Fetch Data if Authenticated (server-side, service-role key — never shipped to the client)
if (isAuthenticated) {
    if (!SERVICE_KEY || !SITE_URL) {
        error = "SUPABASE_SERVICE_ROLE_KEY fehlt in .env";
    } else {
        const supabaseAdmin = createClient(SITE_URL, SERVICE_KEY, {
            auth: { persistSession: false }
        });

        const { data, error: fetchError } = await supabaseAdmin
            .from('master_claims_2026')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(200);

        if (fetchError) {
            error = "Fehler beim Laden: " + fetchError.message;
        } else {
            leads = data;
        }
    }
}

const statTotal = leads.length;
const statAvgs = leads.filter(l => l.avgs_interest).length;

const formatDate = (dateStr) => new Date(dateStr).toLocaleDateString('de-DE');
---

<Layout title="Partner Dashboard | Lead-Verwaltung">
  <main style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; font-family: 'Inter', sans-serif;">

    {!isAuthenticated ? (
      /* LOGIN FORM */
      <div style="max-width: 400px; margin: 80px auto;">
        <div style="background: white; padding: 32px; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
          <h2 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 24px 0; color: #0f172a;">Admin Login</h2>
          {error && <div style="margin-bottom: 16px; padding: 12px; background: #fef2f2; color: #b91c1c; border-radius: 8px; font-size: 0.875rem;">{error}</div>}
          <form method="POST">
            <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 6px;">Passwort</label>
            <input type="password" name="password" required style="width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 12px; margin-bottom: 16px;" />
            <button type="submit" style="width: 100%; background: #0f172a; color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 700; cursor: pointer;">Anmelden</button>
          </form>
        </div>
      </div>
    ) : (
      <Fragment>
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 20px;">
          <div>
            <h1 style="font-size: 2rem; font-weight: 900; color: #0f172a; margin: 0;">Partner-Dashboard</h1>
            <p style="color: #64748b; margin: 5px 0 0 0;">Verwaltung der eingegangenen Ansprüche & AVGS-Leads</p>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 0.75rem; font-weight: 800; color: #16a34a; background: #f0fdf4; padding: 5px 12px; border-radius: 99px; text-transform: uppercase;">● Live verbunden</span>
          </div>
        </header>

        {error && <div style="margin-bottom: 24px; padding: 16px; background: #fef2f2; color: #b91c1c; border-radius: 12px;">{error}</div>}

        <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 3rem;">
          <div style="background: white; padding: 25px; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="color: #64748b; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">Leads Gesamt</span>
            <div style="font-size: 2.5rem; font-weight: 900; color: #0f172a;">{statTotal}</div>
          </div>
          <div style="background: #eff6ff; padding: 25px; border-radius: 24px; border: 1px solid #dbeafe; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="color: #2563eb; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">AVGS Potenzial (Coaching)</span>
            <div style="font-size: 2.5rem; font-weight: 900; color: #2563eb;">{statAvgs}</div>
          </div>
          <div style="background: white; padding: 25px; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <span style="color: #64748b; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">Fristwahrungen Heute</span>
            <div style="font-size: 2.5rem; font-weight: 900; color: #0f172a;">2026</div>
          </div>
        </section>

        <section style="background: white; border-radius: 32px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
          <div style="padding: 25px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-weight: 800;">Aktuelle Leads</h3>
            <a href="/admin/dashboard" style="background: #f1f5f9; border: none; padding: 8px 15px; border-radius: 8px; font-weight: 700; cursor: pointer; color: #475569; text-decoration: none;">Aktualisieren ↻</a>
          </div>
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
              <thead>
                <tr style="background: #f8fafc; border-bottom: 1px solid #f1f5f9;">
                  <th style="padding: 20px; font-size: 0.75rem; text-transform: uppercase; color: #64748b;">Datum</th>
                  <th style="padding: 20px; font-size: 0.75rem; text-transform: uppercase; color: #64748b;">Name / Stadt</th>
                  <th style="padding: 20px; font-size: 0.75rem; text-transform: uppercase; color: #64748b;">Einkommen</th>
                  <th style="padding: 20px; font-size: 0.75rem; text-transform: uppercase; color: #64748b;">Anspruch</th>
                  <th style="padding: 20px; font-size: 0.75rem; text-transform: uppercase; color: #64748b;">AVGS</th>
                </tr>
              </thead>
              <tbody>
                {leads.map((lead) => (
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 20px; font-size: 0.9rem; color: #64748b;">{formatDate(lead.created_at)}</td>
                    <td style="padding: 20px;">
                      <div style="font-weight: 800; color: #0f172a;">{lead.full_name}</div>
                      <div style="font-size: 0.75rem; color: #64748b;">📍 {lead.city}</div>
                    </td>
                    <td style="padding: 20px; font-weight: 600;">{lead.income} €</td>
                    <td style="padding: 20px; color: #16a34a; font-weight: 800;">+ {lead.total_claim_value} €</td>
                    <td style="padding: 20px;">
                      {lead.avgs_interest
                        ? <span style="background: #dcfce7; color: #166534; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 900;">BÜRO-CHECK</span>
                        : <span style="color: #cbd5e1; font-size: 0.7rem;">-</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {leads.length === 0 && (
              <div style="padding: 40px; text-align: center; color: #64748b;">Keine Leads vorhanden.</div>
            )}
          </div>
        </section>
      </Fragment>
    )}

  </main>
</Layout>