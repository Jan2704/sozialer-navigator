    <script is:inline define:vars={{ cityData: wohngeldData }}>
        window.cityData = cityData;
    </script>

    <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // View Switching Logic is now handled centrally in ResultsSection.astro to ensure consistency
    // Cookie/privacy consent is handled sitewide by components/ui/privacy-banner.astro (in Layout)

    document.addEventListener('DOMContentLoaded', () => {
        // Open lead modal if requested via URL query params
        const params = new URLSearchParams(window.location.search);
        if (params.get('action') === 'bescheid-check' || params.get('action') === 'legal_help') {
            setTimeout(() => {
                if (typeof window.openLeadModal === 'function') {
                    window.openLeadModal('legal_help');
                }
            }, 300);
        }
    });

    // Scroll Triggered Reveal — one authored entrance moment, not repeated identically per section
    document.addEventListener('astro:page-load', () => {
        // Hero: the signature entrance
        const heroTl = gsap.timeline();
        heroTl
            .from('#view-home .hero-title', { opacity: 0, y: 20, duration: 0.7, ease: 'power2.out' })
            .from('#view-home .hero-description', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.45')
            .from('#view-home .hero-stats', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.4')
            .from('#view-home .hero-buttons', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.4');

        // Everything below the fold: a single, quiet fade — no bespoke stagger per section
        gsap.utils.toArray('.process-card, .advantage-card, .mission-visual').forEach((el) => {
            gsap.from(el, {
                scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' },
                opacity: 0,
                y: 16,
                duration: 0.6,
                ease: 'power1.out'
            });
        });
    });
    </script>
    <script is:inline defer src="/scripts/lucide.min.js"></script>
    <script is:inline>
        // Lucide icons init — runs after DOM is fully parsed (script is at body-end)
        if (window.lucide) window.lucide.createIcons();
        document.addEventListener('astro:page-load', () => {
            if (window.lucide) window.lucide.createIcons();
        });
    </script>
    <WbaReminderModal />
</Layout>
