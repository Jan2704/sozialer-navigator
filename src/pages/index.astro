---
// index.astro - Fördercheck 2026 - "Human Clay" (warm, grounded, civic-but-human)
import { wohngeldData } from '../data/wohngeld-data.js';
import { defaultFaqs } from '../data/faqs.js';
import { SmartCalculator } from '../components/smart-calculator.jsx';
import ResultsSection from '../components/results-section.astro';
import SchemaOrg from '../components/seo/seo-schema.astro';
import SuccessRoadmap from '../components/success-roadmap.astro';
import Layout from '../layouts/layout.astro';
import Faq from '../components/faq.astro';
import TrustBadges from '../components/trust-badges.astro';
import WbaReminderModal from '../components/wba-reminder-modal.astro';

import '../styles/global.css';

export const prerender = true;

const description = "Verschenke kein Geld! Finde mit Fördercheck in nur 2 Minuten anonym heraus, welche staatlichen Zuschüsse dir zustehen, und fülle deine Anträge sofort digital aus.";
---

<Layout
    title="Fördercheck — Der universelle Check für staatliche Zuschüsse"
    description={description}
    hideNav={false}
    class="bg-surface-base"
    faq={defaultFaqs}
>

    <!--
    HUMAN CLAY — direction contract
    THESIS: this is a serious, human tool about money the state owes you — not a SaaS dashboard pitch. Refuses glassmorphism, glow blobs, and startup-teal.
    OWN-WORLD: warm kraft paper (#EDE6D9) + ink (#2B1D16) + clay (#9C4A32) + ochre (#C98A2E, graphics only) + olive (#4B5A45). Bitter (sturdy slab serif) for headlines, Public Sans (USWDS's own civic typeface) for body — flat opaque cards, no blur, no glass, small structured radii.
    STORY: a first-time applicant, wary of Amtsdeutsch, sees a plain-language question, a real number, and a downloadable form — and trusts it enough to act.
    FIRST VIEWPORT: headline left / ledger-style input-engine-result card stack right, flat warm paper ground, no glow, primary action is the household-size selector.
    FORM: Human Clay, chosen directly with the user after three menu-driven directions failed to land; no concept-seed roll (see chat rationale — catalog challengers unsuited to a trust-critical civic/financial tool).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->

    <!-- Page-specific structured data. Organization/Website schema already comes from Layout, don't duplicate it here. -->
    <fragment slot="head">
        <SchemaOrg type="SoftwareApplication" />

        <script>
            import { gsap } from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';
            import Chart from 'chart.js/auto';

            gsap.registerPlugin(ScrollTrigger);

            window.Chart = Chart;
            window.gsap = gsap;
            window.ScrollTrigger = ScrollTrigger;
        </script>

        <!-- Lucide: deferred to end of body via slot:body-end to avoid render-blocking -->

        <style>
            /* View Transitions */
            .view-section { display: none; opacity: 0; transition: opacity 0.4s ease-in-out; }
            .view-section.active { display: block; opacity: 1; }

            /* Ledger-card connecting line draw */
            @keyframes dash {
                to { stroke-dashoffset: -40; }
            }
            .animate-dash {
                animation: dash 2.2s linear infinite;
            }

            /* Custom float for bottom card with centering */
            @keyframes floatMedium {
                0%, 100% { transform: translate(-50%, 0px) scale(1); }
                50% { transform: translate(-50%, -6px) scale(1.005); }
            }
            .animate-float-medium {
                animation: floatMedium 6s ease-in-out infinite;
            }
        </style>
    </fragment>

    <main class="min-h-screen relative pt-0 pb-32">

        <!-- VIEW 1: HOME -->
        <section id="view-home" class="view-section active w-full relative z-10 bg-[#EDE6D9]">

        <!-- HERO SECTION -->
        <div class="relative w-full min-h-[90vh] flex items-center overflow-hidden bg-[#EDE6D9] border-b border-[#DED2BC]">

            <!-- Content Container -->
            <div class="relative z-10 w-full max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 md:gap-16 items-center pt-28 pb-20">

                <!-- Text Content Left -->
                <div class="lg:col-span-6 relative z-10">
                    <div class="text-left animate-slide-up">

                        <!-- Badge + Social Proof Row -->
                        <div class="flex flex-wrap items-center gap-3 mb-5">
                            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-[#4B5A45]/10 border border-[#4B5A45]/25">
                                <span class="flex h-1.5 w-1.5 rounded-full bg-[#4B5A45]"></span>
                                <span class="text-brand-emerald text-xs font-bold tracking-widest uppercase">Förder-Check 2026</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-xs text-[#6B5B4B]">
                                <i data-lucide="users" class="w-3.5 h-3.5 text-brand-blue flex-shrink-0"></i>
                                <span><span id="social-counter" class="font-bold text-[#2B1D16]">18.423</span> Haushalte haben bereits geprüft</span>
                            </div>
                        </div>

                        <!-- Loss-Framing Headline -->
                        <h1 class="hero-title font-serif font-bold tracking-tight mb-5 text-[#2B1D16] text-5xl md:text-6xl lg:text-[4.25rem] leading-[1.08]">
                            Verschenkst du jeden Monat <span class="text-brand-blue">Geld vom Staat?</span>
                        </h1>

                        <!-- Subline -->
                        <p class="hero-description text-base md:text-lg text-[#6B5B4B] leading-relaxed mb-6 max-w-lg">
                            Die meisten Haushalte wissen nicht, was ihnen zusteht. Prüfe in 2&nbsp;Minuten kostenlos deinen Anspruch auf Wohngeld, Bürgergeld, Kinderzuschlag&nbsp;& mehr.
                        </p>

                        <!-- Stat Pills -->
                        <div class="hero-stats flex flex-wrap gap-2.5 mb-8">
                            <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-[#F7F3EA] border border-[#DED2BC] text-xs">
                                <span class="text-[#8A7A6A]">Ø</span>
                                <span class="font-bold text-[#2B1D16]">487&nbsp;€/Monat</span>
                                <span class="text-[#8A7A6A]">Förderung</span>
                            </div>
                            <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-[#F7F3EA] border border-[#DED2BC] text-xs">
                                <i data-lucide="clock" class="w-3 h-3 text-[#8A7A6A]"></i>
                                <span class="font-bold text-[#2B1D16]">2&nbsp;Minuten</span>
                                <span class="text-[#8A7A6A]">Check</span>
                            </div>
                            <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-[#9C4A32]/10 border border-[#9C4A32]/25 text-xs">
                                <span class="font-bold text-brand-blue">100%</span>
                                <span class="text-brand-blue">Kostenlos</span>
                            </div>
                        </div>

                        <!-- Micro-Commitment Selector -->
                        <div class="hero-buttons">
                            <p class="text-xs font-semibold text-[#6B5B4B] mb-3 uppercase tracking-wider">Wie viele Personen leben in deinem Haushalt?</p>
                            <div class="grid grid-cols-4 gap-2 mb-4 max-w-sm">
                                <button data-persons="1" class="person-selector-btn group flex flex-col items-center gap-1 py-3.5 rounded-lg border-2 border-[#DED2BC] bg-[#F7F3EA] hover:border-[#4B5A45] hover:bg-[#4B5A45]/5 transition-all duration-200 font-bold text-[#2B1D16] text-lg hover:text-brand-emerald" aria-label="1 Person">
                                    1
                                    <span class="text-[9px] font-medium text-[#8A7A6A] group-hover:text-brand-emerald normal-case tracking-normal">Person</span>
                                </button>
                                <button data-persons="2" class="person-selector-btn group flex flex-col items-center gap-1 py-3.5 rounded-lg border-2 border-[#DED2BC] bg-[#F7F3EA] hover:border-[#4B5A45] hover:bg-[#4B5A45]/5 transition-all duration-200 font-bold text-[#2B1D16] text-lg hover:text-brand-emerald" aria-label="2 Personen">
                                    2
                                    <span class="text-[9px] font-medium text-[#8A7A6A] group-hover:text-brand-emerald normal-case tracking-normal">Personen</span>
                                </button>
                                <button data-persons="3" class="person-selector-btn group flex flex-col items-center gap-1 py-3.5 rounded-lg border-2 border-[#DED2BC] bg-[#F7F3EA] hover:border-[#4B5A45] hover:bg-[#4B5A45]/5 transition-all duration-200 font-bold text-[#2B1D16] text-lg hover:text-brand-emerald" aria-label="3-4 Personen">
                                    3–4
                                    <span class="text-[9px] font-medium text-[#8A7A6A] group-hover:text-brand-emerald normal-case tracking-normal">Personen</span>
                                </button>
                                <button data-persons="4" class="person-selector-btn group flex flex-col items-center gap-1 py-3.5 rounded-lg border-2 border-[#DED2BC] bg-[#F7F3EA] hover:border-[#9C4A32] hover:bg-[#9C4A32]/5 transition-all duration-200 font-bold text-[#2B1D16] text-lg hover:text-brand-blue" aria-label="5 oder mehr Personen">
                                    5+
                                    <span class="text-[9px] font-medium text-[#8A7A6A] group-hover:text-brand-blue normal-case tracking-normal">Personen</span>
                                </button>
                            </div>

                            <!-- Trust micro-copy -->
                            <p class="text-[11px] text-[#8A7A6A] flex items-center gap-1.5">
                                <i data-lucide="lock" class="w-3 h-3 flex-shrink-0"></i>
                                Keine Anmeldung &nbsp;·&nbsp; DSGVO-konform &nbsp;·&nbsp; Verschlüsselt übertragen, nie verkauft
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Ledger cards — input, calculation, result, laid out as flat paper index cards -->
                <div class="lg:col-span-6 relative flex justify-center items-center w-full min-h-[480px]">

                    <!-- Connecting line (single ink tone, not a two-color gradient "data stream") -->
                    <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 110 140 C 110 240, 200 240, 230 330" stroke="#2B1D16" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="5 7" class="animate-dash opacity-20" />
                        <path d="M 370 170 C 370 260, 280 260, 250 330" stroke="#2B1D16" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="5 7" class="animate-dash opacity-20" />
                    </svg>

                    <!-- Card 1: Input Profile (Top Left) -->
                    <div class="absolute left-2 top-8 w-[230px] bg-[#F7F3EA] border border-[#DED2BC] rounded-lg p-4.5 shadow-[0_8px_24px_-8px_rgba(43,29,22,0.15)] z-10 hover:-translate-y-0.5 transition-transform duration-300 animate-float-soft">
                        <div class="flex items-center justify-between mb-3.5">
                            <span class="bg-[#4B5A45]/15 text-brand-emerald border border-[#4B5A45]/25 text-[8px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded">Profil</span>
                            <i data-lucide="users" class="w-3.5 h-3.5 text-[#8A7A6A]"></i>
                        </div>
                        <h4 class="text-[#2B1D16] text-xs font-bold mb-1">3-Personen-Haushalt</h4>
                        <p class="text-[#8A7A6A] text-[10px] font-medium leading-tight mb-3">Mutter (34) & 2 Kinder (6, 9)</p>

                        <div class="w-full h-[1px] bg-[#DED2BC] my-3"></div>

                        <div class="space-y-2.5 text-[9px] text-[#6B5B4B] font-bold">
                            <div class="flex justify-between items-center mb-1">
                                <span>Kaltmiete: 620 €</span>
                                <span class="text-brand-emerald">Mietstufe IV</span>
                            </div>
                            <div class="w-full bg-[#E1D8C6] h-1.5 rounded-full overflow-hidden">
                                <div class="bg-[#4B5A45] h-full w-3/4 rounded-full"></div>
                            </div>
                            <div class="flex justify-between items-center mt-2">
                                <span>Netto-Einkommen</span>
                                <span class="text-[#2B1D16]">2.100 € / mtl.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Calculation in progress (Top Right) -->
                    <div class="absolute right-2 top-20 w-[220px] bg-[#F7F3EA] border border-[#DED2BC] rounded-lg p-4.5 shadow-[0_8px_24px_-8px_rgba(43,29,22,0.15)] z-10 hover:-translate-y-0.5 transition-transform duration-300 animate-float-soft-reverse">
                        <div class="flex items-center justify-between mb-3.5">
                            <span class="bg-[#9C4A32]/15 text-brand-indigo border border-[#9C4A32]/25 text-[8px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded">Prüfung läuft</span>
                            <div class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue"></span>
                            </div>
                        </div>

                        <div class="space-y-2 text-[9px] text-[#6B5B4B]">
                            <div class="flex items-center gap-1.5">
                                <span class="text-brand-indigo font-bold">✓</span>
                                <span>Freibeträge nach SGB II geprüft</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="text-brand-indigo font-bold">✓</span>
                                <span>Wohngeldtabelle 2026 abgeglichen</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="text-brand-indigo font-bold">✓</span>
                                <span>Heizkostenpauschale berücksichtigt</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3: Result (Center Bottom) -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[340px] bg-[#F7F3EA] border-2 border-brand-blue rounded-xl p-5.5 shadow-[0_20px_48px_-16px_rgba(43,29,22,0.22)] z-20 hover:-translate-y-0.5 transition-transform duration-500 animate-float-medium">
                        <div class="flex justify-between items-center mb-3">
                            <span class="text-[#8A7A6A] text-[8px] font-bold uppercase tracking-widest">Monatlicher Zuschuss</span>
                            <span class="bg-brand-blue text-[#F7F3EA] text-[7px] font-bold uppercase px-2 py-0.5 rounded">Ergebnis</span>
                        </div>

                        <div class="text-[2.75rem] font-serif font-bold text-brand-blue tracking-tight leading-none mb-1 select-none">
                            672,00 €
                        </div>
                        <p class="text-[#2B1D16] text-[10px] font-bold leading-normal mb-4">Dein berechneter Anspruch pro Monat</p>

                        <!-- Mini Breakdown grid -->
                        <div class="grid grid-cols-2 gap-2 mb-4">
                            <div class="bg-[#EDE6D9] border border-[#DED2BC] rounded-lg p-2.5 text-left">
                                <span class="block text-[#8A7A6A] text-[7px] uppercase tracking-wider font-bold mb-0.5">Wohngeld</span>
                                <span class="text-[#2B1D16] text-xs font-bold">380,00 €</span>
                            </div>
                            <div class="bg-[#EDE6D9] border border-[#DED2BC] rounded-lg p-2.5 text-left">
                                <span class="block text-[#8A7A6A] text-[7px] uppercase tracking-wider font-bold mb-0.5">Kinderzuschlag</span>
                                <span class="text-brand-emerald text-xs font-bold">292,00 €</span>
                            </div>
                        </div>

                        <!-- Generator Action Status -->
                        <div class="border-t border-[#DED2BC] pt-3 flex items-center justify-between">
                            <div class="text-[#8A7A6A] text-[8px] flex items-center gap-1.5">
                                <span class="flex h-1.5 w-1.5 rounded-full bg-brand-blue"></span>
                                <span>Antrag_fertig.pdf generiert</span>
                            </div>
                            <span class="text-brand-emerald hover:underline text-[9px] font-bold flex items-center gap-0.5 cursor-pointer">
                                PDF Download
                                <i data-lucide="download" class="w-3 h-3 stroke-[2.5]"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Interaction Scripts -->
        <script>
            // --- Social Proof Counter Animation ---
            (function() {
                const el = document.getElementById('social-counter');
                if (!el) return;
                const target = 18423;
                const start = 17800;
                const duration = 1800;
                const startTime = performance.now();
                function step(now) {
                    const elapsed = now - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // Ease-out cubic
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.round(start + (target - start) * eased);
                    el.textContent = current.toLocaleString('de-DE');
                    if (progress < 1) requestAnimationFrame(step);
                }
                // Start after a short delay so it's visible
                setTimeout(() => requestAnimationFrame(step), 400);
            })();

            // --- Micro-Commitment Selector ---
            document.querySelectorAll('.person-selector-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const persons = this.dataset.persons;

                    // Visual feedback: highlight selected
                    document.querySelectorAll('.person-selector-btn').forEach(b => {
                        b.classList.remove('border-[#4B5A45]', 'bg-[#4B5A45]/10', 'text-brand-emerald', 'scale-[1.05]');
                        b.classList.add('border-[#DED2BC]', 'bg-[#F7F3EA]', 'text-[#2B1D16]');
                    });
                    this.classList.remove('border-[#DED2BC]', 'bg-[#F7F3EA]', 'text-[#2B1D16]');
                    this.classList.add('border-[#4B5A45]', 'bg-[#4B5A45]/10', 'text-brand-emerald', 'scale-[1.05]');

                    // Fire custom event for SmartCalculator
                    document.dispatchEvent(new CustomEvent('foerdercheck:preselect', { detail: { persons } }));

                    // Scroll to calculator
                    const calc = document.getElementById('calculator');
                    if (calc) calc.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
        </script>

        <!-- Spacing container -->
        <div class="h-16 w-full bg-[#EDE6D9] relative z-10 border-none"></div>


         <!-- CALCULATOR SECTION -->
        <section id="calculator" class="w-full bg-[#EDE6D9] pb-24 pt-12 border-b border-[#DED2BC] relative">
            <div class="relative z-10 max-w-3xl mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B1D16] mb-4">Berechne deinen Anspruch in 2 Minuten</h2>
                    <p class="text-[#6B5B4B] text-base max-w-lg mx-auto leading-relaxed">
                        Anonym und DSGVO-konform. Gib deine Daten ein, um sofort die für dich finanziell beste Sozialleistung zu ermitteln.
                    </p>
                </div>

                <!-- The Calculator Container -->
                <div class="bg-[#F7F3EA] p-8 md:p-12 rounded-xl border border-[#DED2BC] shadow-[0_16px_40px_-16px_rgba(43,29,22,0.12)] text-left relative">
                    <SmartCalculator client:load />
                </div>
            </div>
        </section>

        <!-- PROCESS SECTION -->
        <div class="w-full bg-[#E1D8C6] pb-40 pt-24 relative border-t border-[#DED2BC]">
             <div class="max-w-7xl mx-auto px-6 mb-20 relative z-10">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#2B1D16] mb-6">
                        Vom Anspruch zur <span class="text-brand-indigo">Auszahlung.</span>
                    </h2>
                    <p class="text-[#6B5B4B] text-lg max-w-2xl mx-auto leading-relaxed">
                        Wir begleiten dich nicht nur beim Rechnen, sondern bis das Geld auf deinem Konto ist.
                    </p>
                </div>

                <div class="process-grid relative grid md:grid-cols-4 gap-y-10 gap-x-6">
                    <!-- Connecting rail (desktop) -->
                    <div class="hidden md:block absolute top-6 left-[12.5%] right-[12.5%] h-px bg-[#DED2BC]" aria-hidden="true"></div>

                    <!-- Step 1 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-brand-blue text-brand-indigo font-bold flex items-center justify-center mb-5">1</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Check starten</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Beantworte in 2 Minuten einfache Fragen zu Einkommen, Wohnsituation und Familie. Anonym und ohne Anmeldung.
                         </p>
                    </div>

                    <!-- Step 2 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] text-[#8A7A6A] font-bold flex items-center justify-center mb-5">2</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Ergebnisse sehen</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Du siehst sofort alle Förderungen, die dir zustehen – Wohngeld, Bürgergeld, Kinderzuschlag & mehr – mit genauen Beträgen.
                         </p>
                    </div>

                    <!-- Step 3 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] text-[#8A7A6A] font-bold flex items-center justify-center mb-5">3</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">PDF herunterladen</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Lade deinen fertig befüllten Original-Antrag herunter – direkt drucken und beim Amt einreichen.
                         </p>
                    </div>

                    <!-- Step 4: the payoff, visually distinct from the three setup steps -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#4B5A45] text-[#F7F3EA] font-bold flex items-center justify-center mb-5">4</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Auszahlung</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Das Amt bearbeitet deinen Antrag und das Geld landet direkt auf deinem Konto. Im Schnitt über 300€ Förderung pro Monat.
                         </p>
                    </div>
                </div>
             </div>
        </div>

        <!-- SECTION: WARUM FÖRDERCHECK -->
        <div class="w-full bg-[#EDE6D9] py-32 border-t border-[#DED2BC]">
            <div class="max-w-7xl mx-auto px-6">

                <!-- Header -->
                <div class="text-center mb-24 max-w-3xl mx-auto">
                     <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#2B1D16] mb-8">Der einfachste Weg zu deinem Recht.</h2>
                     <div class="w-16 h-0.5 bg-brand-blue/40 mx-auto"></div>
                </div>

                <div class="advantages-grid grid md:grid-cols-2 gap-8 items-stretch">

                     <!-- Featured: the actual core value prop -->
                     <div class="advantage-card relative overflow-hidden rounded-xl bg-[#2B1D16] p-10 md:p-12 flex flex-col justify-center">
                          <div class="relative z-10">
                              <div class="w-14 h-14 bg-white/5 rounded-lg flex items-center justify-center text-[#C98A2E] mb-8 border border-white/10">
                                  <i data-lucide="trending-up" class="w-6 h-6"></i>
                              </div>
                              <h3 class="text-3xl font-serif font-bold text-[#F7F3EA] mb-4">Maximiere deinen Anspruch</h3>
                              <p class="text-[#C9BBA8] leading-relaxed">
