---
// index.astro - Fördercheck 2026 - "Human Clay" (warm, grounded, civic-but-human)
import { wohngeldData } from '../data/wohngeld-data.js';
import { defaultFaqs } from '../data/faqs.js';
import { SmartCalculator } from '../components/smart-calculator.jsx';
import ResultsSection from '../components/results-section.astro';
import SchemaOrg from '../components/seo/seo-schema.astro';
import SuccessRoadmap from '../components/success-roadmap.astro';
import Layout from '../layouts/layout.astro';
import Faq from '../components/faq.astro';
import TrustBadges from '../components/trust-badges.astro';
import WbaReminderModal from '../components/wba-reminder-modal.astro';

import '../styles/global.css';

export const prerender = true;

const description = "Verschenke kein Geld! Finde mit Fördercheck in nur 2 Minuten anonym heraus, welche staatlichen Zuschüsse dir zustehen, und fülle deine Anträge sofort digital aus.";
---

<Layout
    title="Fördercheck — Der universelle Check für staatliche Zuschüsse"
    description={description}
    hideNav={false}
    class="bg-surface-base"
    faq={defaultFaqs}
>

    <!--
    HUMAN CLAY — direction contract
    THESIS: this is a serious, human tool about money the state owes you — not a SaaS dashboard pitch. Refuses glassmorphism, glow blobs, and startup-teal.
    OWN-WORLD: warm kraft paper (#EDE6D9) + ink (#2B1D16) + clay (#9C4A32) + ochre (#C98A2E, graphics only) + olive (#4B5A45). Bitter (sturdy slab serif) for headlines, Public Sans (USWDS's own civic typeface) for body — flat opaque cards, no blur, no glass, small structured radii.
    STORY: a first-time applicant, wary of Amtsdeutsch, sees a plain-language question, a real number, and a downloadable form — and trusts it enough to act.
    FIRST VIEWPORT: headline left / ledger-style input-engine-result card stack right, flat warm paper ground, no glow, primary action is the household-size selector.
    FORM: Human Clay, chosen directly with the user after three menu-driven directions failed to land; no concept-seed roll (see chat rationale — catalog challengers unsuited to a trust-critical civic/financial tool).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->

    <!-- Page-specific structured data. Organization/Website schema already comes from Layout, don't duplicate it here. -->
    <fragment slot="head">
        <SchemaOrg type="SoftwareApplication" />

        <script>
            import { gsap } from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';
            import Chart from 'chart.js/auto';

            gsap.registerPlugin(ScrollTrigger);

            window.Chart = Chart;
            window.gsap = gsap;
            window.ScrollTrigger = ScrollTrigger;
        </script>

        <!-- Lucide: deferred to end of body via slot:body-end to avoid render-blocking -->

        <style>
            /* View Transitions */
            .view-section { display: none; opacity: 0; transition: opacity 0.4s ease-in-out; }
            .view-section.active { display: block; opacity: 1; }

            /* Ledger-card connecting line draw */
            @keyframes dash {
                to { stroke-dashoffset: -40; }
            }
            .animate-dash {
                animation: dash 2.2s linear infinite;
            }

            /* Custom float for bottom card with centering */
            @keyframes floatMedium {
                0%, 100% { transform: translate(-50%, 0px) scale(1); }
                50% { transform: translate(-50%, -6px) scale(1.005); }
            }
            .animate-float-medium {
                animation: floatMedium 6s ease-in-out infinite;
            }
        </style>
    </fragment>

    <main class="min-h-screen relative pt-0 pb-32">

        <!-- VIEW 1: HOME -->
        <section id="view-home" class="view-section active w-full relative z-10 bg-[#EDE6D9]">

        <!-- HERO SECTION -->
        <div class="relative w-full min-h-[90vh] flex items-center overflow-hidden bg-[#EDE6D9] border-b border-[#DED2BC]">

            <!-- Content Container: "Der Brief" meets "Der ehrliche Bescheid" — plain-language
                 address on the left, a small ledger-card narrative on the right that shows the
                 product working (Frage -> Berechnung -> Ergebnis) instead of describing it. -->
            <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-28 pb-20 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

                <div class="lg:col-span-7 text-left animate-slide-up">

                    <p class="hero-title font-serif text-xl md:text-2xl text-[#6B5B4B] mb-5">Liebe Leserin, lieber Leser,</p>

                    <h1 class="hero-title font-serif font-bold tracking-tight mb-7 text-[#2B1D16] text-4xl md:text-5xl lg:text-[3.4rem] leading-[1.2]">
                        vermutlich steht dir <span class="text-brand-blue">mehr vom Staat zu</span>, als du denkst.
                    </h1>

                    <p class="hero-description text-lg md:text-xl text-[#6B5B4B] leading-relaxed mb-10 max-w-2xl">
                        Die meisten Haushalte prüfen ihren Anspruch nie — nicht weil er nicht besteht, sondern weil niemand es ihnen einfach erklärt hat.
                    </p>

                    <!-- The value-add, spelled out plainly — no badges, just what you actually get -->
                    <div class="hero-stats mb-10 max-w-xl">
                        <p class="text-sm font-bold uppercase tracking-wide text-[#8A7A6A] mb-4">Was du in 2 Minuten bekommst</p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3 text-base md:text-lg text-[#2B1D16] leading-snug">
                                <span class="text-brand-emerald font-serif mt-0.5">—</span>
                                <span>Eine ehrliche Einschätzung, ob dir Wohngeld, Bürgergeld oder Kinderzuschlag zusteht</span>
                            </li>
                            <li class="flex items-start gap-3 text-base md:text-lg text-[#2B1D16] leading-snug">
                                <span class="text-brand-emerald font-serif mt-0.5">—</span>
                                <span>Den genauen Betrag — centgenau berechnet, nicht geschätzt</span>
                            </li>
                            <li class="flex items-start gap-3 text-base md:text-lg text-[#2B1D16] leading-snug">
                                <span class="text-brand-emerald font-serif mt-0.5">—</span>
                                <span>Einen fertig ausgefüllten Antrag zum Download, den du direkt einreichen kannst</span>
                            </li>
                        </ul>
                    </div>

                    <div class="hero-buttons">
                        <a href="#calculator" class="hero-cta-link inline-flex items-center gap-2 font-serif text-lg md:text-xl font-bold text-brand-blue border-b-2 border-brand-blue pb-1 hover:gap-3 transition-all duration-200">
                            Jetzt kostenlos prüfen
                            <span aria-hidden="true">→</span>
                        </a>
                        <p class="text-sm text-[#8A7A6A] mt-5">Kostenlos · Anonym · Keine Anmeldung nötig</p>
                    </div>
                </div>

                <!-- Ledger-card narrative: shows the product working, not a dashboard mockup.
                     Three flat Kartenpapier cards connected by a hand-drawn hairline, ending in
                     the result card (2px Ton border, per the signature-component spec). -->
                <div class="hero-ledger-stack lg:col-span-5 relative hidden lg:block" aria-hidden="true">
                    <svg class="absolute left-9 top-0 h-full w-px overflow-visible" viewBox="0 0 2 400" preserveAspectRatio="none">
                        <line x1="1" y1="0" x2="1" y2="400" stroke="#9C4A32" stroke-width="2" stroke-dasharray="1 9" stroke-linecap="round" class="animate-dash" />
                    </svg>

                    <div class="relative flex flex-col gap-8 pl-[4.5rem]">
                        <div class="hero-ledger-card relative bg-[#F7F3EA] border border-[#DED2BC] rounded-card p-6 shadow-[0_8px_24px_-8px_rgba(43,29,22,0.15)] animate-float-soft">
                            <span class="absolute -left-[4.5rem] top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] flex items-center justify-center text-xs font-bold text-[#8A7A6A]">1</span>
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#8A7A6A] mb-2">Deine Angabe</p>
                            <p class="font-sans font-bold text-[#2B1D16] text-base">Kaltmiete: 650&nbsp;€</p>
                        </div>

                        <div class="hero-ledger-card relative bg-[#F7F3EA] border border-[#DED2BC] rounded-card p-6 shadow-[0_8px_24px_-8px_rgba(43,29,22,0.15)] animate-float-soft-reverse">
                            <span class="absolute -left-[4.5rem] top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] flex items-center justify-center text-xs font-bold text-[#8A7A6A]">2</span>
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#8A7A6A] mb-2">Wird geprüft</p>
                            <p class="font-sans font-bold text-[#2B1D16] text-base">Wohngeld · Mietstufe 4</p>
                        </div>

                        <div class="hero-ledger-card hero-ledger-result relative bg-[#F7F3EA] border-2 border-brand-blue rounded-card p-7 shadow-[0_20px_48px_-16px_rgba(43,29,22,0.22)]">
                            <span class="absolute -left-[4.5rem] top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-brand-blue text-[#F7F3EA] flex items-center justify-center text-xs font-bold">3</span>
                            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-indigo mb-2">Dein Anspruch</p>
                            <p class="font-serif font-bold text-brand-blue text-4xl tracking-tight">737&nbsp;€</p>
                            <p class="text-sm text-[#6B5B4B] mt-1">pro Monat</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Interaction Scripts -->
        <script>
            // "Der Brief" hero has no dashboard figure and no household-size buttons —
            // the household question now lives only inside the calculator itself. The
            // one authored motion moment is the staggered fade-up of salutation ->
            // headline -> body -> value list -> CTA, handled by the shared
            // "Scroll Triggered Reveal" hero timeline further down this file.

            // --- Social Proof Counter Animation ---
            (function() {
                const el = document.getElementById('social-counter');
                if (!el) return;
                const target = 18423;
                const start = 17800;
                const duration = 1800;
                const startTime = performance.now();
                function step(now) {
                    const elapsed = now - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // Ease-out cubic
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.round(start + (target - start) * eased);
                    el.textContent = current.toLocaleString('de-DE');
                    if (progress < 1) requestAnimationFrame(step);
                }
                // Start after a short delay so it's visible
                setTimeout(() => requestAnimationFrame(step), 400);
            })();
        </script>

        <!-- Spacing container -->
        <div class="h-16 w-full bg-[#EDE6D9] relative z-10 border-none"></div>


         <!-- CALCULATOR SECTION -->
        <section id="calculator" class="w-full bg-[#EDE6D9] pb-24 pt-12 border-b border-[#DED2BC] relative">
            <div class="relative z-10 max-w-3xl mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B1D16] mb-4">Berechne deinen Anspruch in 2 Minuten</h2>
                    <p class="text-[#6B5B4B] text-base max-w-lg mx-auto leading-relaxed">
                        Anonym und DSGVO-konform. Gib deine Daten ein, um sofort die für dich finanziell beste Sozialleistung zu ermitteln.
                    </p>
                </div>

                <!-- The Calculator Container -->
                <div class="bg-[#F7F3EA] p-8 md:p-12 rounded-xl border border-[#DED2BC] shadow-[0_16px_40px_-16px_rgba(43,29,22,0.12)] text-left relative">
                    <SmartCalculator client:load />
                </div>
            </div>
        </section>

        <!-- PROCESS SECTION -->
        <div class="w-full bg-[#E1D8C6] pb-40 pt-24 relative border-t border-[#DED2BC]">
             <div class="max-w-7xl mx-auto px-6 mb-20 relative z-10">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#2B1D16] mb-6">
                        Vom Anspruch zur <span class="text-brand-indigo">Auszahlung.</span>
                    </h2>
                    <p class="text-[#6B5B4B] text-lg max-w-2xl mx-auto leading-relaxed">
                        Wir begleiten dich nicht nur beim Rechnen, sondern bis das Geld auf deinem Konto ist.
                    </p>
                </div>

                <div class="process-grid relative grid md:grid-cols-4 gap-y-10 gap-x-6">
                    <!-- Connecting rail (desktop) -->
                    <div class="hidden md:block absolute top-6 left-[12.5%] right-[12.5%] h-px bg-[#DED2BC]" aria-hidden="true"></div>

                    <!-- Step 1 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-brand-blue text-brand-indigo font-bold flex items-center justify-center mb-5">1</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Check starten</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Beantworte in 2 Minuten einfache Fragen zu Einkommen, Wohnsituation und Familie. Anonym und ohne Anmeldung.
                         </p>
                    </div>

                    <!-- Step 2 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] text-[#8A7A6A] font-bold flex items-center justify-center mb-5">2</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Ergebnisse sehen</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Du siehst sofort alle Förderungen, die dir zustehen – Wohngeld, Bürgergeld, Kinderzuschlag & mehr – mit genauen Beträgen.
                         </p>
                    </div>

                    <!-- Step 3 -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#F7F3EA] border-2 border-[#DED2BC] text-[#8A7A6A] font-bold flex items-center justify-center mb-5">3</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">PDF herunterladen</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Lade deinen fertig befüllten Original-Antrag herunter – direkt drucken und beim Amt einreichen.
                         </p>
                    </div>

                    <!-- Step 4: the payoff, visually distinct from the three setup steps -->
                    <div class="process-card relative flex flex-col items-start">
                         <div class="relative z-10 w-12 h-12 rounded-full bg-[#4B5A45] text-[#F7F3EA] font-bold flex items-center justify-center mb-5">4</div>
                         <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-3">Auszahlung</h3>
                         <p class="text-sm text-[#6B5B4B] leading-relaxed">
                             Das Amt bearbeitet deinen Antrag und das Geld landet direkt auf deinem Konto. Im Schnitt über 300€ Förderung pro Monat.
                         </p>
                    </div>
                </div>
             </div>
        </div>

        <!-- SECTION: WARUM FÖRDERCHECK -->
        <div class="w-full bg-[#EDE6D9] py-32 border-t border-[#DED2BC]">
            <div class="max-w-7xl mx-auto px-6">

                <!-- Header -->
                <div class="text-center mb-24 max-w-3xl mx-auto">
                     <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#2B1D16] mb-8">Der einfachste Weg zu deinem Recht.</h2>
                     <div class="w-16 h-0.5 bg-brand-blue/40 mx-auto"></div>
                </div>

                <div class="advantages-grid grid md:grid-cols-2 gap-8 items-stretch">

                     <!-- Featured: the actual core value prop -->
                     <div class="advantage-card relative overflow-hidden rounded-xl bg-[#2B1D16] p-10 md:p-12 flex flex-col justify-center">
                          <div class="relative z-10">
                              <div class="w-14 h-14 bg-white/5 rounded-lg flex items-center justify-center text-[#C98A2E] mb-8 border border-white/10">
                                  <i data-lucide="trending-up" class="w-6 h-6"></i>
                              </div>
                              <h3 class="text-3xl font-serif font-bold text-[#F7F3EA] mb-4">Maximiere deinen Anspruch</h3>
                              <p class="text-[#C9BBA8] leading-relaxed">
                                  Unser smarter Algorithmus berechnet deinen Anspruch centgenau und holt das Maximum aus allen aktuellen gesetzlichen Freibeträgen für dich raus.
                              </p>
                          </div>
                     </div>

                     <!-- Supporting pair -->
                     <div class="flex flex-col justify-center gap-10">
                          <div class="flex items-start gap-5">
                              <div class="w-12 h-12 flex-shrink-0 bg-[#F7F3EA] rounded-lg flex items-center justify-center text-brand-blue border border-[#DED2BC]">
                                  <i data-lucide="smartphone" class="w-5 h-5"></i>
                              </div>
                              <div>
                                  <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-2">100% Digital</h3>
                                  <p class="text-[#6B5B4B] leading-relaxed">
                                      Kein Drucker? Kein Problem. Alles passiert direkt auf deinem Smartphone. Wir machen lästigen Papierkram komplett digital.
                                  </p>
                              </div>
                          </div>

                          <div class="border-t border-[#DED2BC]"></div>

                          <div class="flex items-start gap-5">
                              <div class="w-12 h-12 flex-shrink-0 bg-[#F7F3EA] rounded-lg flex items-center justify-center text-[#6B5B4B] border border-[#DED2BC]">
                                  <i data-lucide="shield-check" class="w-5 h-5"></i>
                              </div>
                              <div>
                                  <h3 class="text-xl font-serif font-bold text-[#2B1D16] mb-2">Verschlüsselt & DSGVO-konform</h3>
                                  <p class="text-[#6B5B4B] leading-relaxed">
                                      Deine Privatsphäre ist uns wichtig. Deine Angaben werden verschlüsselt übertragen, ausschließlich zur Berechnung deines Anspruchs verwendet und nie an Dritte verkauft.
                                  </p>
                              </div>
                          </div>
                     </div>

                </div>
            </div>
        </div>

        <!-- SECTION: WER SIND WIR -->
        <div class="w-full bg-[#E1D8C6] py-32 border-y border-[#DED2BC]">
            <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-20 items-center">

                <!-- Text Content -->
                <div>
                    <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#2B1D16] mb-8 leading-tight">
                        Soziale Hilfen, <br/> endlich einfach.
                    </h2>
                    <div class="space-y-6 text-lg text-[#6B5B4B] leading-relaxed">
                        <p>
                            Millionen an staatlichen Hilfen bleiben jedes Jahr ungenutzt, weil Anträge zu kompliziert oder Rechte schlicht unbekannt sind. Fördercheck ändert das.
                        </p>
                        <p>
                            Wir übersetzen kompliziertes Amtsdeutsch in einfache Prozesse. Unser Ziel: dir schnell, sicher und unbürokratisch zu zeigen, welche Ansprüche du hast – damit du erhältst, was dir zusteht.
                        </p>
                    </div>

                    <div class="mt-12 grid grid-cols-2 gap-8 py-8 border-t border-[#DED2BC]">
                         <div>
                             <div class="text-4xl font-serif font-bold text-brand-blue mb-2">100%</div>
                             <div class="text-xs uppercase tracking-widest text-[#6B5B4B] font-bold">Unabhängig</div>
                         </div>
                         <div>
                             <div class="text-4xl font-serif font-bold text-brand-emerald mb-2">DSGVO</div>
                             <div class="text-xs uppercase tracking-widest text-[#6B5B4B] font-bold">Konform</div>
                         </div>
                    </div>
                </div>

                <!-- Visual Area: Clean Typography -->
                <div class="mission-visual relative">
                     <div class="relative bg-[#F7F3EA] p-12 shadow-[0_16px_40px_-16px_rgba(43,29,22,0.15)] rounded-xl border border-[#DED2BC]">
                          <i data-lucide="quote" class="w-10 h-10 text-brand-blue mb-6 opacity-40"></i>
                          <p class="text-2xl font-serif font-bold text-[#2B1D16] leading-relaxed mb-8">
                             "Staatliche Hilfen sind dein Recht, kein Privileg. Wir machen den Weg dorthin so einfach wie nie zuvor."
                          </p>
                     </div>
                </div>

            </div>
        </div>

            <!-- FAQ SECTION -->
            <div id="view-faq">
                <Faq />
            </div>

        </section>

        <!-- VIEW: RESULTS (via Component) -->
        <ResultsSection />

    </main>

    <!-- NOTIFICATION -->
    <div id="notification-toast" class="bg-[#2B1D16] text-[#F7F3EA] px-6 py-4 rounded-lg shadow-xl flex items-center gap-4 fixed bottom-6 left-1/2 -translate-x-1/2 z-[300] hidden transform translate-y-4 opacity-0 transition-all border border-black/10">
        <i data-lucide="check-circle" class="text-[#C98A2E]"></i>
        <span id="toast-message" class="text-sm font-semibold tracking-wide">Status aktualisiert.</span>
    </div>

    <script is:inline define:vars={{ cityData: wohngeldData }}>
        window.cityData = cityData;
    </script>

    <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // View Switching Logic is now handled centrally in ResultsSection.astro to ensure consistency
    // Cookie/privacy consent is handled sitewide by components/ui/privacy-banner.astro (in Layout)

    document.addEventListener('DOMContentLoaded', () => {
        // Open lead modal if requested via URL query params
        const params = new URLSearchParams(window.location.search);
        if (params.get('action') === 'bescheid-check' || params.get('action') === 'legal_help') {
            setTimeout(() => {
                if (typeof window.openLeadModal === 'function') {
                    window.openLeadModal('legal_help');
                }
            }, 300);
        }
    });

    // Scroll Triggered Reveal — one authored entrance moment, not repeated identically per section
    document.addEventListener('astro:page-load', () => {
        // Hero: the signature entrance
        const heroTl = gsap.timeline();
        heroTl
            .from('#view-home .hero-title', { opacity: 0, y: 20, duration: 0.7, ease: 'power2.out' })
            .from('#view-home .hero-description', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.45')
            .from('#view-home .hero-stats', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.4')
            .from('#view-home .hero-buttons', { opacity: 0, y: 12, duration: 0.6, ease: 'power2.out' }, '-=0.4')
            .from('#view-home .hero-ledger-card', { opacity: 0, y: 16, stagger: 0.15, duration: 0.6, ease: 'power2.out' }, '-=0.5');

        // Everything below the fold: a single, quiet fade — no bespoke stagger per section
        gsap.utils.toArray('.process-card, .advantage-card, .mission-visual').forEach((el) => {
            gsap.from(el, {
                scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' },
                opacity: 0,
                y: 16,
                duration: 0.6,
                ease: 'power1.out'
            });
        });
    });
    </script>
    <script is:inline defer src="/scripts/lucide.min.js"></script>
    <script is:inline>
        // Lucide icons init — runs after DOM is fully parsed (script is at body-end)
        if (window.lucide) window.lucide.createIcons();
        document.addEventListener('astro:page-load', () => {
            if (window.lucide) window.lucide.createIcons();
        });
    </script>
    <WbaReminderModal />
</Layout>
